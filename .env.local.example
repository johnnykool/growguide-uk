# Copy this file to .env.local and fill in your keys.
# Both keys are used server-side only (in API route handlers) and are never exposed to the browser.

# OpenWeatherMap — free tier includes the 5 day / 3 hour forecast endpoint.
# Sign up at https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key

# Anthropic Claude API — used to generate growing advice.
# Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
